# ── Streamlit secrets template ────────────────────────────────────────────
# LOCAL testing: copy this file to ".streamlit/secrets.toml" and add your key.
#   (that real secrets.toml is gitignored and will NOT be pushed to GitHub)
#
# STREAMLIT COMMUNITY CLOUD: do NOT commit your key. Instead open your app,
# go to  Manage app -> Settings -> Secrets  and paste the same lines there.

OPENAI_API_KEY = "sk-your-key-here"
OPENAI_MODEL = "gpt-4o"
OPENAI_TEMPERATURE = "0.2"
